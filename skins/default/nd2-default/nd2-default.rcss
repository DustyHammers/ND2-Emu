/* Circuit-bent mode (Cmd-click; body class bent): the opened panel over the background and under the controls, a
   bend pot per pad (Off and bends 1-8 at frames 0, 16, 32, 48, 64, 79, 95, 111, 127) and the indicator LED (lit; it
   flickers while a pot turns: the runtime sets the lamp's opacity). */
div#bendpanel { display: none; position: absolute; left: 196dp; top: 37dp; width: 1322dp; height: 166dp; decorator: image(ND2BendPanel.png); }
bendpot, bendled { display: none; position: absolute; }
body.bent div#bendpanel, body.bent bendpot, body.bent bendled { display: block; }
bendpot { top: 88dp; width: 60dp; height: 60dp; frames: 128; spriteprefix: bend_; }
#bend1 { left: 320dp; }
#bend2 { left: 525dp; }
#bend3 { left: 730dp; }
#bend4 { left: 935dp; }
#bend5 { left: 1140dp; }
#bend6 { left: 1345dp; }
bendled { left: 1427.5dp; top: 77.5dp; width: 50dp; height: 50dp; decorator: image(bendled_off); }
bendled lamp { display: block; position: absolute; left: 0dp; top: 0dp; width: 50dp; height: 50dp; decorator: image(bendled_on); }
