body { width: 1725dp; height: 1075dp; background-color: #2b2b2e; }
div.layer { position: absolute; left: 0dp; top: 0dp; width: 1725dp; height: 1075dp; }
#layer_01_jacks { decorator: image(ND2Layer01Jacks.png); }
#layer_02_body { decorator: image(ND2Layer02Body.png); }
#layer_03_panels { decorator: image(ND2Layer03Panels.png); }
#layer_04_display { decorator: image(ND2Layer04Display.png); }
#layer_05_redprint { decorator: image(ND2Layer05RedPrint.png); }
#layer_06_tagboxes { decorator: image(ND2Layer06TagBoxes.png); }
#layer_07_lines { decorator: image(ND2Layer07Lines.png); }
#layer_08_text { decorator: image(ND2Layer08Text.png); }
#layer_09_wordmark { decorator: image(ND2Layer09Wordmark.png); }

pbutton, led, knob, encoder, segdigit { display: block; position: absolute; }
pbutton { width: 122dp; height: 59dp; }
pbutton.black { decorator: image(btn_black_up); }  pbutton.black.pressed, pbutton.black.held { decorator: image(btn_black_down); }
pbutton.grey { decorator: image(btn_grey_up); }    pbutton.grey.pressed, pbutton.grey.held { decorator: image(btn_grey_down); }
/* LEDs: the lamp fades in over the unlit lens; the runtime sets the lamp opacity from the OS's LED brightness */
led { width: 22dp; height: 22dp; }
led lamp { display: block; position: absolute; left: -3dp; top: -3dp; width: 28dp; height: 28dp; opacity: 0; }
led.red { decorator: image(led_red_off); }      led.red lamp { decorator: image(led_red_on); }
led.green { decorator: image(led_green_off); }  led.green lamp { decorator: image(led_green_on); }
knob#master { frames: 128; spriteprefix: master_; }
encoder#value { frames: 72; detents: 24; spriteprefix: enc_; }
/* display digit: unlit segments as the background, one child per segment, shown with class lit */
segdigit { width: 88dp; height: 106dp; decorator: image(seg_unlit); }
segdigit seg { display: block; position: absolute; left: 0dp; top: 0dp; width: 88dp; height: 106dp; visibility: hidden; }
segdigit seg.lit { visibility: visible; }
segdigit seg.a { decorator: image(seg_a); } segdigit seg.b { decorator: image(seg_b); } segdigit seg.c { decorator: image(seg_c); } segdigit seg.d { decorator: image(seg_d); } segdigit seg.e { decorator: image(seg_e); } segdigit seg.f { decorator: image(seg_f); } segdigit seg.g { decorator: image(seg_g); } segdigit seg.dp { decorator: image(seg_dp); }

