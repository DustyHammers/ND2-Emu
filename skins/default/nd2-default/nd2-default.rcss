/* ND2 default skin. Canvas 1725 x 1035 dp; art at 2x (1 dp = 2 px). Generated by tools/skin/package.py; */
/* positions match the background art, so move a control here and in the art together. */

@spritesheet buttons_black { src: ND2BlackButton.png; resolution: 2x; btn_black_up: 0px 0px 244px 118px; btn_black_down: 0px 118px 244px 118px; }
