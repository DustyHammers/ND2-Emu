/* ND2 default skin. Canvas 1725 x 1035 dp; art at 2x (1 dp = 2 px). Generated from the layered source; */
/* positions match the background layers, so move a control here and in the art together. */

@spritesheet buttons_black { src: ND2BlackButton.png; resolution: 2x; btn_black_up: 0px 0px 244px 118px; btn_black_down: 0px 118px 244px 118px; }
@spritesheet buttons_grey { src: ND2GreyButton.png; resolution: 2x; btn_grey_up: 0px 0px 244px 118px; btn_grey_down: 0px 118px 244px 118px; }
@spritesheet leds_red { src: ND2RedLed.png; resolution: 1x; led_red_off: 0px 0px 31px 31px; led_red_on: 0px 31px 31px 31px; }
@spritesheet leds_green { src: ND2GreenLed.png; resolution: 1x; led_green_off: 0px 0px 31px 31px; led_green_on: 0px 31px 31px 31px; }
@spritesheet segments { src: ND2DisplaySegments.png; resolution: 2x; seg_unlit: 0px 0px 176px 212px; seg_a: 176px 0px 176px 212px; seg_b: 352px 0px 176px 212px; seg_c: 528px 0px 176px 212px; seg_d: 704px 0px 176px 212px; seg_e: 880px 0px 176px 212px; seg_f: 1056px 0px 176px 212px; seg_g: 1232px 0px 176px 212px; seg_dp: 1408px 0px 176px 212px; }
